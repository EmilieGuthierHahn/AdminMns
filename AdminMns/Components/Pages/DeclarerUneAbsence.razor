@page "/DeclarerUneAbsence"
@rendermode RenderMode.InteractiveServer

@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using System.ComponentModel.DataAnnotations
@using AdminMns.ViewModels
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using System.IO
@using AdminMns.Data
@using AdminMns.Models
@using Microsoft.AspNetCore.Components.Authorization

@inject ApplicationDbContext DbContext
@inject ILogger<DeclarerUneAbsence> Logger
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="containerGlobalDeclarerAbsence">
	<div class="container-fluid contDeclarerAbsence">
		<div class="containerNotifications">
			<div class="notification">
				<i class="bi bi-bell"></i>
			</div>
			<div class="notifMessage">
				<i class="bi bi-chat-left-dots"></i>
			</div>
		</div>

		<div class="row">
			<main class="containerDeclarerAbsence">

				<h1 class="titreAbsence">Déclarer une absence</h1>

				@if (!string.IsNullOrEmpty(successMessage))
				{
					<div class="alert alert-success" role="alert">
						@successMessage
					</div>
				}
				@if (!string.IsNullOrEmpty(errorMessageForDisplay))
				{
					<div class="alert alert-danger" role="alert">
						@errorMessageForDisplay
					</div>
				}

				<EditForm Model="Model" OnSubmit="DeclarerAbsence" FormName="DeclarerAbsenceForm">
					<DataAnnotationsValidator />
					<ValidationSummary class="text-danger d-none" />

					<div class="mb-3">
						<label for="raisonAbsence" class="form-label">Raison de l'absence</label>
						<InputSelect @bind-Value="Model.RaisonAbsence" class="form-select" id="raisonAbsence">
							<option value="">-- Choisissez une raison --</option>
							<option value="1">Maladie</option>
							<option value="2">Rendez-vous</option>
							<option value="3">Transport</option>
							<option value="4">Autre</option>
						</InputSelect>
						<ValidationMessage For="@(() => Model.RaisonAbsence)" class="text-danger" />
					</div>

					<div class="mb-3">
						<label for="exampleFormControlTextarea1" class="form-label">Expliquez plus en détail</label>
						<InputTextArea @bind-Value="Model.TextAreaAbsence" class="form-control" id="exampleFormControlTextarea1" rows="3"></InputTextArea>
					</div>

					<div class="date-picker mb-3">
						<label for="start-date">Date de début :</label>
						<InputDate @bind-Value="Model.DateDebutAbsence" id="start-date" class="form-control" />
						<ValidationMessage For="@(() => Model.DateDebutAbsence)" class="text-danger" />

						<label for="end-date">Date de fin :</label>
						<InputDate @bind-Value="Model.DateFinAbsence" id="end-date" class="form-control" />
						<ValidationMessage For="@(() => Model.DateFinAbsence)" class="text-danger" />
					</div>

					<div class="mb-3">
						<label for="formFile" class="form-label">Envoyez votre justificatif (PDF uniquement, max 75Mo, obligatoire)</label>
						<InputFile id="formFile" OnChange="HandleFileSelected" class="form-control" />
						@if (isFileErrorActive)
						{
							<div class="text-danger validation-message field-validation-error">@fileErrorMessage</div>
						}
						@if (Model.JustificatifFile != null && !isFileErrorActive)
						{
							<p class="mt-2 text-info">Fichier sélectionné : @Model.JustificatifFile.Name</p>
						}
					</div>
					<div class="d-flex mb-3">
						<button type="submit" class="btn boutonDeclaration m-auto" disabled="@isSubmitting">
							@if (isSubmitting)
							{
								<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
								<text> Envoi en cours...</text>
							}
							else
							{
								<text>Envoyer</text>
							}
						</button>
					</div>
				</EditForm>
			</main>
		</div>
	</div>
	<div id="footer">
		@* <Footer /> *@
	</div>
</div>

@code {
	[SupplyParameterFromForm]
	private AbsenceViewModel Model { get; set; } = new();

	private bool isSubmitting;
	private string? successMessage;
	private string? errorMessageForDisplay;
	private string? fileErrorMessage;
	private bool isFileErrorActive;

	private const long MAX_FILE_SIZE = 75 * 1024 * 1024; // 75 MB

	private void HandleFileSelected(InputFileChangeEventArgs e)
	{
		Logger.LogInformation("[BlazorAppLog] HandleFileSelected déclenché. Nombre de fichiers dans l'événement: {FileCount}", e.FileCount);
		Model.JustificatifFile = null;
		fileErrorMessage = null;
		isFileErrorActive = false;

		if (errorMessageForDisplay == "Merci de fournir un justificatif valable (PDF requis)." ||
		 (errorMessageForDisplay != null && (errorMessageForDisplay.StartsWith("Le fichier doit être") || errorMessageForDisplay.StartsWith("Le fichier PDF sélectionné est vide") || errorMessageForDisplay.Contains("trop volumineux"))))
		{
			errorMessageForDisplay = null;
		}

		var file = e.GetMultipleFiles(1).FirstOrDefault();

		if (file != null)
		{
			Logger.LogInformation("[BlazorAppLog] Fichier reçu par HandleFileSelected: Nom='{FileName}', Taille={FileSize}, TypeMIME='{FileContentType}'", file.Name, file.Size, file.ContentType);
			if (file.ContentType != "application/pdf" && !file.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
			{
				fileErrorMessage = "Le fichier doit être au format PDF.";
				isFileErrorActive = true;
				Logger.LogWarning("[BlazorAppLog] Validation échouée: Le fichier n'est pas un PDF. Type détecté: {ContentType}", file.ContentType);
			}
			else if (file.Size == 0)
			{
				fileErrorMessage = "Le fichier PDF sélectionné est vide et ne peut pas être utilisé.";
				isFileErrorActive = true;
				Logger.LogWarning("[BlazorAppLog] Validation échouée: Fichier PDF vide. Taille: {FileSize}", file.Size);
			}
			else if (file.Size > MAX_FILE_SIZE)
			{
				fileErrorMessage = $"Le fichier PDF '{file.Name}' est trop volumineux ({file.Size / (1024.0 * 1024.0):F1} Mo). Maximum: {MAX_FILE_SIZE / (1024 * 1024)} Mo.";
				isFileErrorActive = true;
				Logger.LogWarning("[BlazorAppLog] Validation échouée: Fichier PDF trop volumineux. Taille: {FileSize}", file.Size);
			}
			else
			{
				Model.JustificatifFile = file;
				Logger.LogInformation("[BlazorAppLog] Fichier PDF '{FileName}' assigné à Model.JustificatifFile.", Model.JustificatifFile.Name);
			}
		}
		else
		{
			Logger.LogWarning("[BlazorAppLog] HandleFileSelected: Aucun fichier reçu de InputFileChangeEventArgs (e.GetMultipleFiles().FirstOrDefault() est null).");
		}
		StateHasChanged();
	}

	public async Task DeclarerAbsence(EditContext editContext)
	{
		Logger.LogInformation("[BlazorAppLog] Début de DeclarerAbsence. Model.JustificatifFile est {StatusFichierAvantValidation}. fileErrorMessage: '{MsgErreurFichier}'", Model.JustificatifFile == null ? "NULL" : "assigné (" + Model.JustificatifFile.Name + ")", fileErrorMessage);
		isSubmitting = true;
		successMessage = null;
		errorMessageForDisplay = null;
		isFileErrorActive = false;

		StateHasChanged();

		if (!string.IsNullOrEmpty(fileErrorMessage))
		{
			errorMessageForDisplay = fileErrorMessage;
			isFileErrorActive = true;
			Logger.LogWarning("[BlazorAppLog] Erreur fichier de HandleFileSelected propagée: {ErrorMsg}", fileErrorMessage);
			isSubmitting = false;
			StateHasChanged();
			return;
		}

		bool modelDataAnnotationsValid = editContext.Validate();
		if (!modelDataAnnotationsValid)
		{
			Logger.LogWarning("[BlazorAppLog] Le modèle n'est pas valide (DataAnnotations).");
			errorMessageForDisplay = "Le formulaire contient des erreurs. Veuillez corriger les champs indiqués.";
			isSubmitting = false;
			StateHasChanged();
			return;
		}

		if (Model.DateDebutAbsence.HasValue && Model.DateFinAbsence.HasValue && Model.DateFinAbsence < Model.DateDebutAbsence)
		{
			Logger.LogWarning("[BlazorAppLog] Validation personnalisée échouée : la date de fin est antérieure à la date de début.");
			errorMessageForDisplay = "La date de fin ne peut pas être antérieure à la date de début.";
			isSubmitting = false;
			StateHasChanged();
			return;
		}

		if (Model.JustificatifFile == null)
		{
			Logger.LogWarning("[BlazorAppLog] Aucun fichier justificatif présent dans Model.JustificatifFile (obligatoire). fileErrorMessage était: '{InitialFileError}'", fileErrorMessage);
			fileErrorMessage = "Merci de fournir un justificatif valable (PDF requis).";
			errorMessageForDisplay = fileErrorMessage;
			isFileErrorActive = true;
			isSubmitting = false;
			StateHasChanged();
			return;
		}

		Logger.LogInformation("[BlazorAppLog] Toutes les validations initiales passées. Fichier présent: {FileName}", Model.JustificatifFile.Name);

		// --- DÉBUT DE LA LOGIQUE MODIFIÉE POUR RÉCUPÉRER LE STAGIAIRE CONNECTÉ ---
		var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
		var user = authState.User; // <--- ICI, 'user' EST DÉCLARÉ ET INITIALISÉ

		// Ensuite, il y a une vérification pour s'assurer que l'utilisateur est authentifié :
		if (user.Identity == null || !user.Identity.IsAuthenticated)
		{
			errorMessageForDisplay = "Utilisateur non authentifié. Impossible de déclarer une absence.";
			Logger.LogWarning("[BlazorAppLog] Tentative de déclaration d'absence par un utilisateur non authentifié.");
			isSubmitting = false;
			StateHasChanged();
			return; // Important: on sort de la méthode si non authentifié
		}

		// Et SEULEMENT ENSUITE vient la ligne où tu utilises 'user' pour obtenir utilisateurId :
		var utilisateurId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

		// Recherche le stagiaire correspondant à cet ID utilisateur dans la table Stagiaires
		// Ta classe Stagiaire a une propriété UtilisateurId qui est la clé étrangère vers AppUser.Id
		var stagiaireConnecte = await DbContext.Stagiaires
											  .FirstOrDefaultAsync(s => s.UtilisateurId == utilisateurId);

		if (stagiaireConnecte == null)
		{
			errorMessageForDisplay = "Aucun profil stagiaire n'est associé à votre compte. Veuillez contacter l'administration.";
			Logger.LogWarning("[BlazorAppLog] Aucun stagiaire trouvé avec UtilisateurId: {UtilisateurId}", utilisateurId);
			isSubmitting = false;
			StateHasChanged();
			return;
		}
		// --- FIN DE LA LOGIQUE MODIFIÉE POUR RÉCUPÉRER LE STAGIAIRE CONNECTÉ ---

		string? nomFichierSauvegarde = null;
		try
		{
			var nomFichierOriginal = Path.GetFileName(Model.JustificatifFile!.Name);
			var extensionFichier = Path.GetExtension(nomFichierOriginal);
			nomFichierSauvegarde = $"{Guid.NewGuid()}{extensionFichier}";

			var dossierDeSauvegarde = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "justificatifs_absences");
			if (!Directory.Exists(dossierDeSauvegarde)) Directory.CreateDirectory(dossierDeSauvegarde);
			var cheminCompletFichier = Path.Combine(dossierDeSauvegarde, nomFichierSauvegarde);

			await using var stream = new FileStream(cheminCompletFichier, FileMode.Create);
			await Model.JustificatifFile.OpenReadStream(MAX_FILE_SIZE).CopyToAsync(stream);
			Logger.LogInformation("[BlazorAppLog] Fichier '{OriginalName}' sauvegardé: {SavedName}", nomFichierOriginal, nomFichierSauvegarde);
		}
		catch (Exception ex)
		{
			Logger.LogError(ex, "[BlazorAppLog] Erreur sauvegarde fichier.");
			errorMessageForDisplay = $"Erreur traitement fichier: {ex.Message}";
			isSubmitting = false; StateHasChanged(); return;
		}

		
		// Récupérer l'utilisateur connecté : https://learn.microsoft.com/en-us/aspnet/core/blazor/security/?view=aspnetcore-9.0&tabs=visual-studio#authenticationstateprovider-service
		// Il faut mettre en place le AuthenticationState

		// TODO: Faire un DbContext.FindAsync d'un stagiaire where IdUtilisateur = l'id du user connecté qu'on a récupéré

		// ici je gère l'affichage dans la bdd du texte du motif de l'absence, à partir du value de l'option du formulaire
		string motifTexte; // Variable pour stocker le texte final du motif

		switch (Model.RaisonAbsence)
		{
			case "1":
				motifTexte = "Maladie";
				break;
			case "2":
				motifTexte = "Rendez-vous";
				break;
			case "3":
				motifTexte = "Transport";
				break;
			case "4":
				motifTexte = "Autre";
				break;
			default:
				// Ce cas est atteint si Model.RaisonAbsence est vide ("") ou une valeur inattendue.
				// Tu devrais avoir une validation pour t'assurer qu'une raison valide est sélectionnée.
				// Si la validation est passée, ce cas ne devrait pas être problématique,
				// mais par sécurité, on peut assigner une valeur ou lever une erreur.
				Logger.LogWarning("[BlazorAppLog] Raison d'absence non valide ou non sélectionnée: {RaisonAbsenceValue}", Model.RaisonAbsence);
				// Option 1: Mettre une valeur par défaut (si le champ Motif peut être vide ou avoir une valeur par défaut)
				motifTexte = "Raison non spécifiée";
				// Option 2: Retourner une erreur à l'utilisateur (plus robuste si le champ est requis)
				// errorMessageForDisplay = "Veuillez sélectionner une raison valide pour l'absence.";
				// isSubmitting = false;
				// StateHasChanged();
				// return; // Sortir de la méthode si la raison est invalide et requise.
				break;
		}

		// Ajoute les détails du champ TextArea si nécessaire
		// (Model.TextAreaAbsence est la propriété liée à ton <InputTextArea>)
		if (!string.IsNullOrWhiteSpace(Model.TextAreaAbsence))
		{
			if (Model.RaisonAbsence == "4") // Si la raison est "Autre", les détails sont la suite directe
			{
				motifTexte += $": {Model.TextAreaAbsence}";
			}
			else // Pour les autres raisons, on peut ajouter les détails entre parenthèses
			{
				motifTexte += $" (Détails: {Model.TextAreaAbsence})";
			}
		}

		// Maintenant, utilise motifTexte pour initialiser ta nouvelle absence
		var nouvelleAbsence = new Absence
		{
			DateDebut = Model.DateDebutAbsence.GetValueOrDefault(),
			DateFin = Model.DateFinAbsence.GetValueOrDefault(),
			Motif = motifTexte, // ✅ Ici, on assigne le texte converti
			Justificatif = nomFichierSauvegarde,
			Stagiaire = stagiaireConnecte
			// DateDeclaration est gérée par sa valeur par défaut dans le modèle Absence
		};

		try
		{
			if (DbContext.Absences == null)
			{
				Logger.LogError("[BlazorAppLog] Le DbSet Absences est null.");
				errorMessageForDisplay = "Erreur de configuration de la base de données.";
				isSubmitting = false; StateHasChanged(); return;
			}
			DbContext.Absences.Add(nouvelleAbsence);
			await DbContext.SaveChangesAsync();

			Logger.LogInformation("[BlazorAppLog] Absence (ID: {AbsenceId}) sauvegardée.", nouvelleAbsence.IdAbsence);
			successMessage = "Votre déclaration d'absence a été enregistrée !";
			Model = new AbsenceViewModel();
			fileErrorMessage = null;
			isFileErrorActive = false;
			errorMessageForDisplay = null;
			StateHasChanged();
		}
		catch (DbUpdateException dbEx)
		{
			Logger.LogError(dbEx, "[BlazorAppLog] Erreur DbUpdateException: {InnerEx}", dbEx.InnerException?.Message);
			errorMessageForDisplay = $"Erreur BDD: {dbEx.InnerException?.Message ?? dbEx.Message}. Vérifiez IdStagiaire.";
		}
		catch (Exception ex)
		{
			Logger.LogError(ex, "[BlazorAppLog] Erreur générale sauvegarde.");
			errorMessageForDisplay = $"Erreur générale: {ex.Message}";
		}
		finally
		{
			isSubmitting = false;
			StateHasChanged();
		}
	}
}