
@page "/DeclarerUneAbsence"

@using System.ComponentModel.DataAnnotations

<div class="containerGlobalDeclarerAbsence">
	<div class="container-fluid contDeclarerAbsence">
		<div class="containerNotifications">
			<div class="notification">
				<i class="bi bi-bell"></i>
			</div>
			<div class="notifMessage">
				<i class="bi bi-chat-left-dots"></i>
			</div>
		</div>


		<div class="row">
			

			<main class="containerDeclarerAbsence">
				<h1 class="titreAbsence">Déclarer une absence</h1>
				<EditForm Model="Model" OnInvalidSubmit="DeclarerAbsence" FormName="DeclarerAbsenceForm" method="post">
					<DataAnnotationsValidator />
					<ValidationSummary class="text-danger" role="alert" />
					
					<InputSelect @bind-Value="Model.RaisonAbsence" class="form-select" id="raisonAbsence" aria-required="true">
						<option selected>Raison de l'absence</option>
						<option value="1">Maladie</option>
						<option value="2">Rendez-vous</option>
						<option value="3">Transport</option>
						<option value="3">Autre</option>
					</InputSelect>

					<div class="mb-3">
						<label for="exampleFormControlTextarea1" class="form-label">Expliquez plus en détail</label>
						<InputTextArea @bind-Value="Model.TextAreaAbsence" class="form-control" id="exampleFormControlTextarea1" rows="3"></InputTextArea>
					</div>
					<div class="date-picker mb-3">
						<label for="start-date">Date de début :</label>
						<InputDate @bind-Value="Model.DateDebutAbsence" id="start-date" class="form-control" aria-required="true" />
						<ValidationMessage For="@(() => Model.DateDebutAbsence)" class="text-danger" />

						<label for="end-date">Date de fin :</label>
						<InputDate @bind-Value="Model.DateFinAbsence" id="end-date" name="end-date" class="form-control" aria-required="true" />
						<ValidationMessage For="@(() => Model.DateFinAbsence)" class="text-danger" />
					</div>

					<div class="mb-3">
						<label for="formFile" class="form-label">Envoyez votre justificatif</label>
						<InputFile id="formFile" @bind-Value="Model.JustificatifAbsence" class="form-control" aria-required="true" />
						<ValidationMessage For="@(() => Model.JustificatifAbsence)" class="text-danger" />
					</div>
					<div class="d-flex mb-3">
						<button type="submit" class="btn boutonDeclaration m-auto">Envoyer</button>
					</div>
				</EditForm>


			</main>
		</div>

	</div>
	<div id="footer">
		<Footer />
	</div>
</div>

