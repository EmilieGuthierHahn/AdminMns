@page "/Documents"
@using AdminMns.ViewModels
@using AdminMns.Services
@inject IDocumentService DocumentSvc

<div class="containerGlobalDocument">
	<div class="container-fluid contPageDocument">
		<div class="containerNotifications">
			<div class="notification">
				<i class="bi bi-bell"></i>
			</div>
			<div class="notifMessage">
				<i class="bi bi-chat-left-dots"></i>
			</div>
		</div>
		<div class="row">
			<main class="deuxiemeContainerDocument col-md-9 ms-sm-auto col-lg-10 px-md-4">
				<div class="titreAccueil text-center mt-3">
					<h1>Mes documents</h1>
				</div>

				<div class="containerRectangles">
					<div class="rectangles d-flex justify-content-center mt-5">
						<div class="rectangleUn bg-orange rounded p-3 text-center me-3">
							<a class=link href="./declarerAbsence.html"><i class="bi bi-filetype-doc"></i> Déclarer une absence</a>
						</div>
						<div class="rectangleDeux bg-orange rounded p-3 text-center me-3">
							<a class=link href="./declarerRetard.html"><i class="bi bi-filetype-doc"></i> Déclarer un retard</a>
						</div>
						<div class="rectangleTrois bg-orange rounded p-3 text-center">
							<a class=link href="./envoieDocuments.html"><i class="bi bi-filetype-doc"></i> Remettre un document</a>
						</div>
					</div>
					<div class="nombreAbsence">
						<div class="rectangleRetard bg-orange rounded p-3 text-center me-3">
							<i class="bi bi-filetype-doc"></i> Nombre des retard : @compteurRetards
						</div>
						<div class="rectangleAbsence bg-orange rounded p-3 text-center">
							<i class="bi bi-filetype-doc"></i> Nombre d'absence : @compteurAbsences
						</div>
						<div class="rectangleDocument bg-orange rounded p-3 text-center">
							<i class="bi bi-filetype-doc"></i> Documents à rendre : @compteurDocumentsARendre
						</div>
					</div>
					<div class="coupurePage">
						<div class="pacman"></div>
					</div>
					<table class="tableauDocuments">
						<thead>
							<tr>
								<th scope="col">Nom du document</th>
								<th scope="col">Type du dossier</th>
								<th scope="col">Date</th>
								<th scope="col">Statut</th>
							</tr>
						</thead>
						<tbody>
							@if (listeDocumentsVM != null && listeDocumentsVM.Any())
							{
								@foreach (var document in listeDocumentsVM)
								{
									<tr>
										<td scope="row">@document.NomDocument</td>
										<td>@document.TypeDossier</td>
										<td>@document.Date.ToString("dd.MM.yy")</td>
										<td>
											@if (document.Statut == "Reçu")
											{
												@:Reçu <i class="bi bi-check2-circle"></i>
											}
											else if (document.Statut == "En attente")
											{
												@:En attente <i class="bi bi-x-circle"></i>
											}
											else
											{
												@document.Statut
											}
										</td>
									</tr>
								}
							}
							else if (erreurChargement)
							{
								<tr>
									<td colspan="4" class="text-center text-danger">Une erreur est survenue lors du chargement des documents.</td>
								</tr>
							}
							else
							{
								<tr>
									<td colspan="4" class="text-center">Aucun document à afficher.</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</main>
		</div>
	</div>
	<div id="footer">
		<Footer />
	</div>
</div>
@code {
	private List<DocumentViewModel>? listeDocumentsVM;
	private bool erreurChargement = false;

	private int compteurRetards;
	private int compteurAbsences;
	private int compteurDocumentsARendre;

	protected override async Task OnInitializedAsync()
	{
		try
		{
			// Charger les documents en premier
			listeDocumentsVM = await DocumentSvc.RecupererListeDocumentsAsync();

			// Ensuite, charger les compteurs
			compteurDocumentsARendre = await DocumentSvc.CompterDocumentsARendreAsync();
			compteurRetards = await DocumentSvc.ObtenirNombreRetardsReelsAsync();
			compteurAbsences = await DocumentSvc.ObtenirNombreAbsencesReellesAsync();
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Erreur critique lors du chargement des données pour la page Documents : {ex.Message}");
			// Pensez à un système de logging plus robuste pour la production (ex: Serilog)
			erreurChargement = true;
			listeDocumentsVM = new List<DocumentViewModel>(); // Initialisation pour éviter une erreur de référence nulle
		}
	}

	// Assurez-vous que votre DocumentViewModel possède les propriétés suivantes (ajustez si les noms sont différents) :
	// public class DocumentViewModel
	// {
	//     public string NomDocument { get; set; }
	//     public string TypeDossier { get; set; }
	//     public DateTime Date { get; set; }
	//     public string Statut { get; set; }
	// }
}