@page "/DeclarerUnRetard"
@rendermode RenderMode.InteractiveServer

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using System.IO
@using AdminMns.Data
@using AdminMns.Models

@inject ApplicationDbContext DbContext
@inject ILogger<DeclarerUnRetard> Logger
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@* @inject IUserService UserService // Exemple pour obtenir l'ID utilisateur *@

<div class="containerGlobalDeclarerRetard">
    <div class="contDeclarerRetard">
        <div class="containerNotifications">
            <div class="notification">
                <i class="bi bi-bell"></i>
            </div>
            <div class="notifMessage">
                <i class="bi bi-chat-left-dots"></i>
            </div>
        </div>

        <main class="containerDeclarerRetard">
            <h1 class="titreRetard">Déclarer un retard</h1>

            @if (!userIsStagiaire && !isLoadingReasons) @* Si pas stagiaire ET que le chargement initial est fini *@
            {
                <div class="alert alert-danger" role="alert">
                    @errorMessageForDisplay @* Message défini dans OnInitializedAsync *@
                </div>
            }
            else if (isLoadingReasons)
            {
                <p><em>Chargement des raisons des retards...</em></p>
            }
            else
            {
                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="alert alert-success" role="alert">
                        @successMessage
                    </div>
                }
                @if (!string.IsNullOrEmpty(errorMessageForDisplay))
                {
                    <div class="alert alert-danger" role="alert">
                        @errorMessageForDisplay
                    </div>
                }

                <EditForm Model="Model" OnValidSubmit="HandleRetardSubmitAsync" FormName="DeclarerRetardForm">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger d-none" />

                    <div class="mb-3">
                        <label for="idRaisonRetard" class="form-label">Raison du retard</label>
                        <InputSelect @bind-Value="Model.IdRaisonRetard" class="form-select" id="idRaisonRetard">
                            <option value="0">-- Choisissez une raison --</option>
                            @if (raisonsRetard != null)
                            {
                                @foreach (var raison in raisonsRetard)
                                {
                                    <option value="@raison.IdRaisonRetard">@raison.Libelle</option>
                                }
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => Model.IdRaisonRetard)" class="text-danger" />
                    </div>

                    @* Ajout du champ "Expliquez plus en détail" basé sur votre maquette *@
                    <div class="mb-3">
                        <label for="detailsRetard" class="form-label">Expliquez plus en détail (optionnel)</label>
                        <InputTextArea @bind-Value="Model.DetailsRetard" class="form-control" id="detailsRetard" rows="3"></InputTextArea>
                        <ValidationMessage For="@(() => Model.DetailsRetard)" class="text-danger" />
                    </div>

                    <div class="mb-3">
                        <label for="dateArrivee" class="form-label">Date et heure d'arrivée estimée</label>
                        <InputDate Type="InputDateType.DateTimeLocal" @bind-Value="Model.DateArrivee" id="dateArrivee" class="form-control" />
                        <ValidationMessage For="@(() => Model.DateArrivee)" class="text-danger" />
                    </div>

                    <div class="mb-3">
                        <label for="formFileRetard" class="form-label">Envoyez votre justificatif (PDF uniquement, max 75Mo, optionnel)</label>
                        <InputFile id="formFileRetard" OnChange="HandleFileSelectedRetard" class="form-control" />
                        @if (isFileErrorActive)
                        {
                            <div class="text-danger validation-message field-validation-error">@fileErrorMessage</div>
                        }
                        @if (Model.JustificatifFile != null && !isFileErrorActive)
                        {
                            <p class="mt-2 text-info">Fichier sélectionné : @Model.JustificatifFile.Name</p>
                        }
                    </div>

                    <div class="d-flex mb-3">
                        <button type="submit" class="btn boutonDeclaration m-auto" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                <text> Envoi en cours...</text>
                            }
                            else
                            {
                                <text>Envoyer la déclaration</text>
                            }
                        </button>
                    </div>
                </EditForm>
            }
        </main>
    </div>
    <div id="footer">
        <Footer /> @* Assurez-vous que le composant Footer existe et est accessible *@
    </div>
</div>

@code {
    // Modèle de formulaire imbriqué
    private sealed class RetardFormModel
    {
        [Required(ErrorMessage = "La raison du retard est requise.")]
        [Range(1, int.MaxValue, ErrorMessage = "Veuillez sélectionner une raison valide.")]
        public int IdRaisonRetard { get; set; }

        // Ajout du champ DetailsRetard pour correspondre à votre maquette
        [MaxLength(500, ErrorMessage = "Les détails ne peuvent pas dépasser 500 caractères.")]
        public string? DetailsRetard { get; set; }

        [Required(ErrorMessage = "Merci d'entrer une date et heure d'arrivée.")]
        public DateTime? DateArrivee { get; set; } = DateTime.Now;

        public IBrowserFile? JustificatifFile { get; set; }
    }

    [SupplyParameterFromForm]
    private RetardFormModel Model { get; set; } = new();

    private List<RaisonRetard>? raisonsRetard;
    private bool isLoadingReasons = true;
    private bool isSubmitting = false;
    private string? successMessage;
    private string? errorMessageForDisplay;
    private string? fileErrorMessage;
    private bool isFileErrorActive = false;

    private const long MAX_FILE_SIZE = 75 * 1024 * 1024; // 75 MB

    private void HandleFileSelectedRetard(InputFileChangeEventArgs e)
    {
        Logger.LogInformation("[BlazorAppLog Retard] HandleFileSelectedRetard déclenché.");
        Model.JustificatifFile = null;
        fileErrorMessage = null;
        isFileErrorActive = false;

        if (errorMessageForDisplay != null &&
            (errorMessageForDisplay.Contains("PDF") || errorMessageForDisplay.Contains("trop volumineux") || errorMessageForDisplay.Contains("justificatif valable")))
        {
            errorMessageForDisplay = null;
        }

        var file = e.GetMultipleFiles(1).FirstOrDefault();

        if (file != null)
        {
            Logger.LogInformation("[BlazorAppLog Retard] Fichier reçu: Nom='{FileName}', Taille={FileSize}, TypeMIME='{FileContentType}'", file.Name, file.Size, file.ContentType);
            if (file.ContentType != "application/pdf" && !file.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
            {
                fileErrorMessage = "Le fichier doit être au format PDF.";
                isFileErrorActive = true;
            }
            else if (file.Size == 0)
            {
                fileErrorMessage = "Le fichier PDF sélectionné est vide et ne peut pas être utilisé.";
                isFileErrorActive = true;
            }
            else if (file.Size > MAX_FILE_SIZE)
            {
                fileErrorMessage = $"Le fichier PDF '{file.Name}' est trop volumineux ({file.Size / (1024.0 * 1024.0):F1} Mo). Maximum: {MAX_FILE_SIZE / (1024 * 1024)} Mo.";
                isFileErrorActive = true;
            }
            else
            {
                Model.JustificatifFile = file;
            }
        }
        else
        {
            Logger.LogWarning("[BlazorAppLog Retard] HandleFileSelectedRetard: Aucun fichier reçu.");
        }
        StateHasChanged();
    }

    private async Task HandleRetardSubmitAsync(EditContext editContext)
    {
        Logger.LogInformation("[BlazorAppLog Retard] Début de HandleRetardSubmitAsync.");
        isSubmitting = true;
        successMessage = null;
        errorMessageForDisplay = null;
        // isFileErrorActive et fileErrorMessage sont gérés par HandleFileSelectedRetard

        StateHasChanged();

        // --- DÉBUT : Vérification du statut Stagiaire et récupération de l'ID ---
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity == null || !user.Identity.IsAuthenticated)
        {
            errorMessageForDisplay = "Utilisateur non authentifié. Veuillez vous connecter.";
            Logger.LogWarning("[BlazorAppLog Retard] Tentative de soumission par un utilisateur non authentifié.");
            isSubmitting = false;
            StateHasChanged();
            return;
        }

        if (!user.IsInRole("Stagiaire"))
        {
            errorMessageForDisplay = "Seuls les stagiaires sont autorisés à déclarer un retard.";
            Logger.LogWarning("[BlazorAppLog Retard] Tentative de soumission par l'utilisateur {UserName} qui n'est pas un Stagiaire.", user.Identity.Name);
            isSubmitting = false;
            StateHasChanged();
            return;
        }

        var utilisateurIdIdentity = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrEmpty(utilisateurIdIdentity))
        {
            errorMessageForDisplay = "Impossible de vérifier votre identité de stagiaire (ID manquant).";
            Logger.LogError("[BlazorAppLog Retard] L'ID de l'utilisateur (NameIdentifier) est null pour {UserName}.", user.Identity.Name);
            isSubmitting = false;
            StateHasChanged();
            return;
        }

        // Récupérer le profil Stagiaire lié à cet utilisateur Identity
        var stagiaireConnecte = await DbContext.Stagiaires
                                              // .AsNoTracking() // Important si tu ne modifies pas le stagiaire ici
                                              .FirstOrDefaultAsync(s => s.UtilisateurId == utilisateurIdIdentity);

        if (stagiaireConnecte == null)
        {
            errorMessageForDisplay = "Votre profil stagiaire n'a pas été trouvé. Veuillez contacter l'administration.";
            Logger.LogError("[BlazorAppLog Retard] Aucun profil Stagiaire trouvé pour l'utilisateur Identity ID: {IdentityId}, UserName: {UserName}", utilisateurIdIdentity, user.Identity.Name);
            isSubmitting = false;
            StateHasChanged();
            return;
        }

        int currentStagiaireId = stagiaireConnecte.IdStagiaire; // ✅ ID Stagiaire réel récupéré !
        Logger.LogInformation("[BlazorAppLog Retard] Stagiaire ID {StagiaireId} ({UserName}) soumet un retard.", currentStagiaireId, user.Identity.Name);
        // --- FIN : Vérification du statut Stagiaire et récupération de l'ID ---

        // ... (Le reste de ta validation de formulaire : isFileErrorActive, editContext.Validate()) ...
        // que tu avais déjà :
        if (isFileErrorActive && !string.IsNullOrEmpty(fileErrorMessage))
        {
            errorMessageForDisplay = fileErrorMessage;
            Logger.LogWarning("[BlazorAppLog Retard] Erreur fichier de HandleFileSelectedRetard toujours active: {ErrorMsg}", fileErrorMessage);
            isSubmitting = false;
            StateHasChanged();
            return;
        }

        if (!editContext.Validate()) // editContext.Validate() doit être appelé APRES les vérifications manuelles
        {
            Logger.LogWarning("[BlazorAppLog Retard] Le modèle n'est pas valide (DataAnnotations).");
            errorMessageForDisplay = "Le formulaire contient des erreurs. Veuillez corriger les champs indiqués.";
            isSubmitting = false;
            StateHasChanged();
            return;
        }

        // ... (Logique de sauvegarde du fichier justificatif) ...
        // que tu avais déjà

        string? nomFichierSauvegardePourBDD = null;
        if (Model.JustificatifFile != null && !isFileErrorActive) // Model.JustificatifFile est de type IBrowserFile?
        {
            // ... (ta logique de sauvegarde de fichier, elle semble correcte)
        }

        // Construction de l'objet Retard
        var raisonSelectionnee = raisonsRetard?.FirstOrDefault(r => r.IdRaisonRetard == Model.IdRaisonRetard);
        if (raisonSelectionnee == null && Model.IdRaisonRetard != 0) // Si un ID est sélectionné mais non trouvé (ne devrait pas arriver si la liste est à jour)
        {
            errorMessageForDisplay = "La raison du retard sélectionnée est invalide.";
            isSubmitting = false; StateHasChanged(); return;
        }

        // Le Motif est UNIQUEMENT le libellé de la raison sélectionnée.
        string motifPourEnregistrement = raisonSelectionnee?.Libelle ?? "Raison non spécifiée";

        // Les détails saisis par l'utilisateur vont dans le champ 'Details' dédié.
        string detailsPourEnregistrement = Model.DetailsRetard ?? string.Empty; // Model.DetailsRetard vient de ton InputTextArea

        var nouveauRetard = new Retard
        {
            DateArrivee = Model.DateArrivee,
            Justificatif = nomFichierSauvegardePourBDD,
            Motif = motifPourEnregistrement,     // ✅ Ne contient QUE le libellé de la raison principale
            Details = detailsPourEnregistrement, // ✅ Contient les détails saisis par l'utilisateur
            IdStagiaire = currentStagiaireId,
            Stagiaire = stagiaireConnecte     // Assure-toi que stagiaireConnecte est bien l'entité suivie (pas de .AsNoTracking())
        };

        // --- Logique de sauvegarde en base de données ---
        try
        {
            if (DbContext.Retards == null) // Vérification paranoïaque
            {
                Logger.LogError("[BlazorAppLog Retard] Le DbSet Retards est null dans ApplicationDbContext.");
                errorMessageForDisplay = "Erreur de configuration de la base de données (Retards).";
                isSubmitting = false; StateHasChanged(); return;
            }

            DbContext.Retards.Add(nouveauRetard);
            await DbContext.SaveChangesAsync();

            Logger.LogInformation("[BlazorAppLog Retard] Retard (ID: {RetardId}) pour Stagiaire ID: {StagiaireId} sauvegardé.", nouveauRetard.IdRetard, currentStagiaireId);
            successMessage = "Votre déclaration de retard a été enregistrée !";
            Model = new RetardFormModel(); // Réinitialiser
            fileErrorMessage = null;
            isFileErrorActive = false;
            errorMessageForDisplay = null;
        }
        catch (DbUpdateException dbEx)
        {
            Logger.LogError(dbEx, "[BlazorAppLog Retard] Erreur DbUpdateException: {InnerEx}", dbEx.InnerException?.Message);
            errorMessageForDisplay = $"Erreur BDD: {dbEx.InnerException?.Message ?? dbEx.Message}.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[BlazorAppLog Retard] Erreur générale sauvegarde retard.");
            errorMessageForDisplay = $"Erreur générale: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private bool userIsStagiaire = false; // Nouvelle variable d'état

    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("[BlazorAppLog Retard] Initialisation de la page DeclarerUnRetard.");
        
        // Vérifier le rôle de l'utilisateur
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated && user.IsInRole("Stagiaire"))
        {
            userIsStagiaire = true;
            Logger.LogInformation("[BlazorAppLog Retard] L'utilisateur est un Stagiaire.");
            // Continuer avec le chargement des raisons de retard
            isLoadingReasons = true;
            try
            {
                if (DbContext.RaisonsRetard != null)
                {
                    raisonsRetard = await DbContext.RaisonsRetard.AsNoTracking().ToListAsync();
                    Logger.LogInformation("[BlazorAppLog Retard] {Count} raisons de retard chargées.", raisonsRetard?.Count ?? 0);
                }
                // ... (le reste de ta logique de chargement des raisons)
            }
            catch (Exception ex)
            {
                // ... (ta gestion d'erreur existante)
            }
            finally
            {
                isLoadingReasons = false;
            }
        }
        else
        {
            userIsStagiaire = false;
            isLoadingReasons = false; // Pas besoin de charger si pas stagiaire
            if (user.Identity != null && user.Identity.IsAuthenticated) {
                Logger.LogWarning("[BlazorAppLog Retard] L'utilisateur {UserName} n'est pas un Stagiaire.", user.Identity.Name);
                errorMessageForDisplay = "Seuls les stagiaires peuvent déclarer un retard.";
            } else {
                Logger.LogWarning("[BlazorAppLog Retard] Utilisateur non authentifié tentant d'accéder à la déclaration de retard.");
                errorMessageForDisplay = "Vous devez être connecté en tant que stagiaire pour déclarer un retard.";
            }
        }
    }

