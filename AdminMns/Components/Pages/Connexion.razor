@page "/Connexion"
@inject NavigationManager NavigationManager // Injecte le gestionnaire de navigation de Blazor

<PageTitle>Connexion</PageTitle>

<h3>Connexion</h3>

@*
    Ce bloc représente le formulaire de connexion Blazor.
    EditForm est un composant Blazor qui offre des fonctionnalités pour la validation de formulaire et la soumission.
    Model="loginRequest" lie le formulaire à l'objet 'loginRequest' défini dans le bloc @code.
    OnValidSubmit="HandleLogin" appelle la méthode HandleLogin lorsque le formulaire est valide et soumis.
*@
<EditForm>
    @*
        DataAnnotationsValidator active la validation basée sur les Data Annotations (attributs comme [Required], [EmailAddress])
        définis sur les propriétés du modèle 'loginRequest'.
    *@
    <DataAnnotationsValidator />
    @*
        ValidationSummary affiche une liste de tous les messages d'erreur de validation pour le formulaire.
    *@
    <ValidationSummary />

    <div class="form-group">
        <label for="email">Adresse Email:</label>
        @*
            InputText est un composant Blazor pour l'entrée de texte.
            @bind-Value="loginRequest.Email" crée une liaison de données bidirectionnelle :
            - Les changements dans le champ mettent à jour loginRequest.Email.
            - Les changements dans loginRequest.Email mettent à jour le champ.
        *@
        <InputText id="email" class="form-control" />
        @*
            ValidationMessage affiche le message d'erreur de validation spécifique à ce champ
            si une erreur est détectée pour loginRequest.Email.
        *@
        
    </div>
    <div class="form-group">
        <label for="password">Mot De Passe:</label>
        <InputText id="password" type="password" class="form-control" />
        
    </div>
    <br />
    <button type="submit" class="btn btn-primary">Se connecter</button>

    @*
        Ce bloc affiche un message d'erreur si la variable 'errorMessage' n'est pas vide,
        ce qui se produit si la connexion à l'API backend échoue.
    *@
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-3" role="alert">
            @errorMessage
        </div>
    }
</EditForm>

@code {
    // Variable pour stocker les messages d'erreur à afficher à l'utilisateur (ex: "Identifiants invalides").
    private string errorMessage = string.Empty;

    // Méthode asynchrone appelée lorsque le formulaire est validé et soumis.
    private async Task HandleLogin()
    {
    }
}