@page "/ProfilEtudiant"
@rendermode InteractiveServer

    <div class="container-fluid contPageProfil flex-grow-1">
        <h1 class="titreProfil">Modifier mon profil</h1>
        <div class="containerGLobalProfil">
            <main class="col-md-9 col-lg-10">
                <div class="formInscription bg-gris rounded p-4 shadow">
                    <form method="post" action="">
                        <div class="row">
                            <div class="col-md-3 mt-3">
                                <label for="nomUser" class="form-label">Nom</label>
                                <input type="text" class="form-control" id="nomUser" name="nom_user" value="" required>
                            </div>
                            <div class="col-md-3 mt-3">
                                <label for="prenomUser" class="form-label">Prénom</label>
                                <input type="text" class="form-control" id="prenomUser" name="prenom_user" value="" required>
                            </div>
                            <div class="col-md-3 mt-3">
                                <label for="numRue" class="form-label">Numéro rue </label>
                                <input type="text" class="form-control" id="numRue" name="numero_rue" value="" required>
                            </div>
                            <div class="col-md-3 mt-3">
                                <label for="nomRue" class="form-label">Nom rue</label>
                                <input type="text" class="form-control" id="nomRue" name="nom_rue" value="" required>
                            </div>
                        </div>
                        </form>
                     <div class="row"> 
                            <div class="col-md-3 mt-3">
                                <label for="ville" class="form-label">Ville</label>
                                <select type="text" class="form-select" id="ville" name="ville" required>
                                    <option selected disabled value="">Choisissez votre ville</option>
                                </select>
                            </div>
                            <div class="col-md-3 mt-3">
                                <label for="anniUser" class="form-label">Date de naissance</label>
                                <input type="date" class="form-control" id="anniUser" name="anniUser"
                                    value="">
                            </div>
                            <div class="col-md-3 mt-3">
                                <label for="telephone" class="form-label">Numéro de Téléphone </label>
                                <input type="text" class="form-control" id="telephone" name="telephone" value="">
                            </div>
                            <div class="col-md-3 mt-3">
                                <label for="mailUser" class="form-label">Adresse mail</label>
                                <input type="text" class="form-control" id="mailUser" name="email_user" value="" required>
                            </div>
                        </div>
                        <div class="row">

                        </div>
                        <div class="row">
                            <div class="col-12 mt-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" value="" id="invalidCheck" required>
                                    <label class="form-check-label" for="invalidCheck">
                                        Accepter les termes et conditions
                                    </label>
                                </div>
                            </div>
                            <div class="col-12 mt-3">
                                <button class="btn btnFormInscription btn-primary" type="submit">Envoyer</button>
                            </div>
                        </div>
                      
                 
           </div>
                <div class="formInscription bg-gris rounded p-4 shadow">
                    <form method="post" action="">
                        <div class="contAccordeon">
                            <div class="accordion" id="accordionExample">
                                <div class="accordion-item">
                                    <h2 class="accordion-header">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                            data-bs-target="#collapseOne" aria-expanded="false"
                                            aria-controls="collapseOne">
                                            Modifier le mot de passe
                                        </button>
                                    </h2>
                                    <div id="collapseOne" class="accordion-collapse collapse"
                                        data-bs-parent="#accordionExample">
                                        <div class="accordion-body">
                                            <form method="POST" action="">
                                                <div class="row">
                                                    <div class="col-md-4 offset-md-4 mt-2">
                                                        <label for="ancienMdpUser" class="form-label">Ancien mot de passe</label>
                                                        <input type="password" class="form-control ancienMDP" id="ancienMDP"
                                                            name="ancienMdpUser" value="" required>
                                                    </div>
                                                    <div class="col-md-4 offset-md-4 mt-5">
                                                        <label for="NewMdp" class="form-label">Nouveau mot de passe</label>
                                                        <input type="password" class="form-control nouveauMDP" id="nouveauMDP"
                                                            name="NewMdp" value="" required>
                                                    </div>
                                                    <div class="col-md-4 offset-md-4 mt-5">
                                                        <label for="NewmdpConfirm" class="form-label">Confirmer le nouveau mot de passe</label>
                                                        <input type="password" class="form-control confirmNouveauMDP"
                                                            id="confirmNouveauMDP" name="NewmdpConfirm" value="" required>
                                                    </div>
                                                    <div class="col-12 text-center">
                                                        <button class="btn btnChangementMdp" type="submit">Envoyer</button>
                                                    </div>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                                <div class="accordion-item">
                                    <h2 class="accordion-header">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                            data-bs-target="#collapseTwo" aria-expanded="false"
                                            aria-controls="collapseTwo">
                                            Voir mes absences
                                        </button>
                                    </h2>
                                    <div id="collapseTwo" class="accordion-collapse collapse"
                                        data-bs-parent="#accordionExample">
                                        <div class="accordion-body">
                                            <table class="table">
                                                <thead>
                                                    <tr>
                                                        <th>Date</th>
                                                        <th>Motif</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr>
                                                        <td></td>
                                                        <td></td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                                <div class="accordion-item">
                                    <h2 class="accordion-header">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                            data-bs-target="#collapseThree" aria-expanded="false"
                                            aria-controls="collapseThree">
                                            Voir mes retards
                                        </button>
                                    </h2>
                                    <div id="collapseThree" class="accordion-collapse collapse"
                                        data-bs-parent="#accordionExample">
                                        <div class="accordion-body">
                                            <table class="table">
                                                <thead>
                                                    <tr>
                                                        <th>Date</th>
                                                        <th>Durée</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr>
                                                        <td></td>
                                                        <td></td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                                <div class="accordion-item">
                                    <h2 class="accordion-header">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                                data-bs-target="#collapseProfileImage" aria-expanded="false"
                                                aria-controls="collapseProfileImage">
                                            Modifier ma photo de profil
                                        </button>
                                    </h2>
                                    <div id="collapseProfileImage" class="accordion-collapse collapse"
                                         data-bs-parent="#accordionExample">
                                        <div class="accordion-body">
                                            <form action="/upload_profile_image" method="post" enctype="multipart/form-data">
                                                <div>
                                                    <label for="profile_image">Sélectionner une nouvelle image :</label>
                                                    <input type="file" id="profile_image" name="profile_image" accept="image/*">
                                                    <small class="form-text text-muted">Formats acceptés : jpg, jpeg, png, gif.</small>
                                                </div>
                                                
                                                <div class="mt-3">
                                                    <button class="btn btnChangementImage" type="submit">Enregistrer la nouvelle image</button>
                                                </div>
                                            </form>
                                
                                            <div class="mt-3">
                                                <h4>Votre image de profil actuelle :</h4>
                                                <img src="./images/pp emilie .jpg" alt="Image de profil actuelle" style="max-width: 150px; height: auto;">
                                                <small class="form-text text-muted">Ceci est votre image de profil actuelle.</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        </form>
                    </div>
 			</main>

       
		</div>
    <div id="footer">
        <Footer />
    </div>
	</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


     
      
   